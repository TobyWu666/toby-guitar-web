---
/**
 * 全站搜尋（⌘K / Ctrl+K / 「/」打開）。
 * 索引來自 /search.json；用子字串比對，中文不需要斷詞也找得到。
 */
---

<dialog class="search" data-search aria-label="搜尋筆記">
  <div class="search-in">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
    <input type="search" placeholder="搜尋課程、知識點…（例如：音程、五聲）" autocomplete="off" enterkeyhint="search" aria-label="搜尋關鍵字" data-search-q />
    <button type="button" class="close" data-search-close>取消</button>
  </div>
  <div class="results" data-search-results role="listbox" aria-label="搜尋結果"></div>
  <p class="foot">↑↓ 選擇 · Enter 開啟 · Esc 關閉</p>
</dialog>

<style>
  .search {
    width: min(640px, calc(100vw - 24px));
    max-height: min(640px, calc(100dvh - 24px));
    margin: max(12px, 10vh) auto auto;
    padding: 0;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-lg);
    background: var(--surface);
    color: var(--text);
    box-shadow: 0 24px 70px rgb(0 0 0 / 0.35);
    overflow: hidden;
  }
  .search[open] { display: flex; flex-direction: column; }
  .search::backdrop { background: rgb(10 12 14 / 0.45); backdrop-filter: blur(2px); }
  .search-in { display: flex; align-items: center; gap: 10px; padding: 0 12px 0 16px; border-bottom: 1px solid var(--line); }
  .search-in svg { width: 18px; height: 18px; color: var(--muted); flex: none; }
  .search-in input { flex: 1; min-width: 0; border: 0; outline: 0; background: transparent; color: var(--text); font: inherit; font-size: 17px; padding: 16px 0; }
  .search-in input::-webkit-search-cancel-button { display: none; }
  .close { border: 0; background: none; color: var(--accent); font-size: 15px; cursor: pointer; padding: 8px; }
  .results { overflow: auto; padding: 8px; flex: 1; }
  .results :global(.rh) { font-family: var(--font-head); font-size: 13.5px; color: var(--muted); padding: 8px 10px 4px; margin: 0; }
  .results :global(a) { display: block; border-radius: var(--radius); padding: 10px; text-decoration: none; color: var(--text); }
  .results :global(a[aria-selected='true']) { background: var(--surface-2); }
  .results :global(b) { display: block; font-size: 15.5px; font-weight: 600; }
  .results :global(.t) { font-family: var(--font-head); font-weight: 400; font-size: 13px; color: var(--accent); margin-right: 8px; }
  .results :global(small) { display: block; color: var(--muted); font-size: 13px; line-height: 1.55; margin-top: 2px; }
  .results :global(mark) { background: var(--accent-soft); color: var(--accent); border-radius: 3px; padding: 0 1px; }
  .results :global(.none) { color: var(--muted); padding: 18px 10px; margin: 0; }
  .foot { border-top: 1px solid var(--line); padding: 9px 16px; font-size: 12.5px; color: var(--muted); margin: 0; }
  @media (max-width: 720px) { .foot { display: none; } }
</style>

<script>
  import type { SearchItem } from '@/lib/text';

  const dialog = document.querySelector<HTMLDialogElement>('[data-search]')!;
  const input = dialog.querySelector<HTMLInputElement>('[data-search-q]')!;
  const results = dialog.querySelector<HTMLElement>('[data-search-results]')!;
  let index: SearchItem[] | null = null;
  let active = 0;

  const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  const norm = (s: string) => s.toLowerCase();
  function hi(text: string, q: string) {
    if (!q) return esc(text);
    const i = norm(text).indexOf(norm(q));
    if (i < 0) return esc(text);
    return esc(text.slice(0, i)) + '<mark>' + esc(text.slice(i, i + q.length)) + '</mark>' + esc(text.slice(i + q.length));
  }
  function excerpt(body: string, q: string) {
    const i = norm(body).indexOf(norm(q));
    if (i < 0) return '';
    const start = Math.max(0, i - 24);
    return (start > 0 ? '…' : '') + body.slice(start, i + q.length + 40) + '…';
  }
  function score(it: SearchItem, q: string) {
    const has = (s: string) => norm(s).includes(q);
    return (has(it.title) ? 10 : 0) + (has(it.keywords) ? 5 : 0) + (has(it.summary) ? 3 : 0) + (has(it.body) ? 1 : 0) + (has(it.tag) ? 4 : 0);
  }
  function row(it: SearchItem, q: string, i: number) {
    const sub = q && !norm(it.summary).includes(norm(q)) && norm(it.body).includes(norm(q)) ? excerpt(it.body, q) : it.summary;
    return `<a href="${it.url}" role="option" aria-selected="${i === active}" data-i="${i}"><b><span class="t">${esc(it.tag)}</span>${hi(it.title, q)}</b><small>${esc(it.meta)} · ${hi(sub, q)}</small></a>`;
  }
  function render() {
    if (!index) { results.innerHTML = '<p class="none">載入中…</p>'; return; }
    const q = input.value.trim();
    let list: SearchItem[];
    let html: string;
    if (!q) {
      list = index.filter((i) => i.type === 'lesson').slice(0, 5);
      html = '<p class="rh">最近的課程</p>' + list.map((it, i) => row(it, '', i)).join('');
    } else {
      list = index
        .map((it) => ({ it, s: score(it, norm(q)) }))
        .filter((x) => x.s > 0)
        .sort((a, b) => b.s - a.s)
        .slice(0, 20)
        .map((x) => x.it);
      html = list.length ? list.map((it, i) => row(it, q, i)).join('') : `<p class="none">找不到「${esc(q)}」相關的內容</p>`;
    }
    active = Math.min(active, Math.max(0, list.length - 1));
    results.innerHTML = html;
  }
  async function open() {
    if (dialog.open) return;
    dialog.showModal();
    input.value = '';
    active = 0;
    render();
    input.focus();
    if (!index) {
      try { index = await (await fetch('/search.json')).json(); } catch { index = []; }
      render();
    }
  }
  function move(d: number) {
    const opts = [...results.querySelectorAll<HTMLAnchorElement>('[role=option]')];
    if (!opts.length) return;
    active = (active + d + opts.length) % opts.length;
    opts.forEach((o, i) => o.setAttribute('aria-selected', String(i === active)));
    opts[active].scrollIntoView({ block: 'nearest' });
  }

  input.addEventListener('input', () => { active = 0; render(); });
  input.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') { e.preventDefault(); move(1); }
    else if (e.key === 'ArrowUp') { e.preventDefault(); move(-1); }
    else if (e.key === 'Enter') {
      const a = results.querySelector<HTMLAnchorElement>(`[data-i="${active}"]`);
      if (a) location.href = a.href;
    }
  });
  dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
  dialog.querySelector('[data-search-close]')!.addEventListener('click', () => dialog.close());
  document.querySelectorAll('[data-open-search]').forEach((b) => b.addEventListener('click', open));
  document.addEventListener('keydown', (e) => {
    const typing = (e.target as HTMLElement).closest('input, textarea, [contenteditable]');
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); open(); }
    else if (e.key === '/' && !typing) { e.preventDefault(); open(); }
  });
</script>
