---
/**
 * 和弦按法圖。
 *
 *   <Chord name="Am7" frets="x02010" fingers="x02010" />
 *   <Chord name="Bm" frets="x,2,4,4,3,2" />                      ← 有兩位數格數時用逗號分隔
 *   <Chord name="F" frets="133211" fingers="134211" />           ← 同一隻手指按同一格的多條弦 → 自動畫橫按
 *   <Chord name="Am7" frets="x02010">旁邊的說明文字</Chord>        ← 有內文時圖文並排
 *
 * frets / fingers 從第 6 弦（低音 E）寫到第 1 弦；x = 不彈、0 = 空弦。
 * 可以用 /tools/chord/ 的編輯器點一點產生這段程式碼。
 */
import { chordDiagram, parseChordFingers, parseChordFrets } from '@/lib/chord';

interface Props {
  name: string;
  frets: string;
  fingers?: string;
  /** 用來拼音名的根音（選填，例如 Bb 和弦寫 root="Bb" 才會顯示 B♭ 而不是 A♯） */
  root?: string;
  /** 起始格（選填；不填時 4 格內從第 1 格畫琴枕，否則從最低的按壓格開始） */
  base?: number;
  caption?: string;
}
const { name, frets, fingers, root, base, caption } = Astro.props;
const d = chordDiagram({ name, root, base, frets: parseChordFrets(frets), fingers: fingers ? parseChordFingers(fingers) : [] });
const hasText = Astro.slots.has('default');
---

<figure class:list={['figure', 'chord', { 'with-text': hasText }]}>
  <svg class="dg" viewBox={d.viewBox} role="img" aria-label={d.label} set:html={d.body} />
  {hasText && <div class="chord-text"><slot /></div>}
  {caption && <figcaption class="fig-cap">{caption}</figcaption>}
</figure>

<style>
  .chord { display: inline-block; width: 170px; vertical-align: top; margin-right: 10px; }
  .chord.with-text { display: grid; grid-template-columns: 140px minmax(0, 1fr); gap: 24px; align-items: center; width: auto; margin-right: 0; }
  .chord-text :global(p:last-child) { margin-bottom: 0; }
  @media (max-width: 560px) {
    .chord.with-text { grid-template-columns: 110px minmax(0, 1fr); gap: 14px; }
  }
</style>
