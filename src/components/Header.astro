---
import Logo from './Logo.astro';
import { SITE } from '@/data/site';

const path = Astro.url.pathname;
const inMap = path.startsWith('/topics');
const inLessons = path.startsWith('/lessons');
---

<header class="hdr">
  <div class="wrap hdr-in">
    <a class="brand" href="/" aria-label={`${SITE.name} 首頁`}>
      <Logo class="brand-logo" weight={30} />
      <span class="brand-name">{SITE.name}</span>
    </a>
    <nav class="nav" aria-label="主要">
      <a href="/lessons/" aria-current={inLessons ? 'page' : undefined}>課程</a>
      <a href="/topics/" aria-current={inMap ? 'page' : undefined}>知識地圖</a>
    </nav>
    <button class="icon-btn search-btn" type="button" data-open-search aria-label="搜尋筆記">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
      <span class="search-label">搜尋筆記</span><kbd>⌘K</kbd>
    </button>
    <button class="icon-btn theme-btn" type="button" data-theme-toggle aria-label="切換深色／淺色">
      <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"></path></svg>
      <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
    </button>
  </div>
</header>

<style>
  .hdr {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--bg) 86%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
    padding-top: env(safe-area-inset-top, 0px);
  }
  .hdr-in { display: flex; align-items: center; gap: 10px; height: var(--header-h); }
  .brand { display: flex; align-items: center; gap: 12px; color: var(--text); text-decoration: none; margin-right: auto; }
  .brand :global(.brand-logo) { height: 42px; width: auto; }
  .brand-name {
    font-family: var(--font-head);
    font-size: 18px;
    letter-spacing: 0.06em;
    padding-left: 12px;
    border-left: 1.5px solid var(--line-strong);
    white-space: nowrap;
  }
  .nav { display: flex; gap: 2px; margin-right: 6px; }
  .nav a { padding: 6px 12px; border-radius: var(--radius); color: var(--muted); font-size: 15px; text-decoration: none; white-space: nowrap; }
  .nav a:hover { color: var(--text); }
  .nav a[aria-current='page'] { color: var(--text); background: var(--surface-2); }
  .icon-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 38px;
    padding: 0 10px;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--muted);
    border-radius: var(--radius);
    font-size: 14px;
    cursor: pointer;
    white-space: nowrap;
  }
  .icon-btn:hover { color: var(--text); border-color: var(--line-strong); }
  .icon-btn svg { width: 17px; height: 17px; flex: none; }
  kbd { font-family: var(--font-mono); font-size: 11px; padding: 1px 5px; border: 1px solid var(--line); border-radius: 4px; }
  .i-sun { display: none; }
  :global(:root[data-theme='dark']) .i-sun { display: block; }
  :global(:root[data-theme='dark']) .i-moon { display: none; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .i-sun { display: block; }
    :global(:root:not([data-theme='light'])) .i-moon { display: none; }
  }
  @media (max-width: 720px) {
    .hdr-in { height: 60px; gap: 6px; }
    .brand { gap: 8px; }
    .brand :global(.brand-logo) { height: 36px; }
    .brand-name { font-size: 16px; padding-left: 8px; }
    .nav a { padding: 6px 8px; font-size: 14.5px; }
    .search-label, kbd { display: none; }
    .icon-btn { padding: 0 9px; }
  }
  /* 小手機：深淺色切換移到頁尾，留位置給網站名稱 */
  @media (max-width: 420px) {
    .theme-btn { display: none; }
  }
  @media (max-width: 340px) {
    .brand-name { display: none; }
  }
</style>
